widget "updates" {
  page: 4
  order: 2
  size: 3x3
  minSize: 2x2

  // Refreshes a private copy of apt's lists in /tmp, so the real ones stay untouched and
  // apt's lock is never taken.
  source pending = cmd("""
    t=/tmp/owl-updates
    mkdir -p "$t/lists/partial"
    apt-get -o Dir::State::Lists="$t/lists" -o Debug::NoLocking=1 -qq update >/dev/null 2>&1 || { echo error; exit; }
    apt -o Dir::State::Lists="$t/lists" list --upgradable 2>/dev/null | grep upgradable | cut -d/ -f1
  """) every 1h timeout 90s
  let failed = pending == "error"
  let list = pending == null || failed ? null : lines(pending).filter(l => l != "").map(l => words(l)[0])

  onTap: terminal("apt-get update && apt-get full-upgrade", "updates")

  Column {
    gap: 2
    Text { text: "updates"; style: muted }
    Text {
      text: failed ? "offline" : list == null ? "…" : "${len(list)}"
      style: title
      color: failed || list == null ? muted : len(list) > 0 ? yellow : green
    }
    if list != null {
      Text { text: len(list) == 0 ? "up to date" : join(list.take(4), " "); style: small; maxLines: 2 }
    }
  }
}
